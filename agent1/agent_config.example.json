{
  "topic": "AI coding agent industry and competitive landscape",
  "api_key": "",
  "paths": {
    "base_dir": "./runtime_data",
    "document_dir": "./runtime_data/documents",
    "report_dir": "./runtime_data/reports",
    "metadata_path": "./runtime_data/document_index.json",
    "checkpoint_path": "./runtime_data/memory/langgraph_checkpoints.sqlite",
    "performance_log_path": "./runtime_data/performance/runs.jsonl",
    "performance_report_dir": "./runtime_data/performance/reports"
  },
  "search": {
    "max_results": 5,
    "relevance_threshold": 0.3,
    "query": null,
    "semantic_top_k": 6,
    "query_rewrite_count": 3,
    "web_enabled": true,
    "web_provider": "tavily",
    "web_api_key": "",
    "web_endpoint": "https://api.tavily.com/search",
    "web_search_depth": "advanced",
    "web_timeout_seconds": 20.0,
    "web_max_download_bytes": 31457280
  },
  "keywords": {
    "core": [
      "industry report",
      "competitive analysis",
      "market landscape",
      "product documentation",
      "pricing",
      "business model",
      "technical architecture"
    ],
    "extended": [
      "competitor",
      "product features",
      "go-to-market",
      "customer segment",
      "limitation",
      "roadmap"
    ],
    "exclude": [
      "fiction",
      "entertainment",
      "sports"
    ]
  },
  "rag": {
    "parser_backend": "docling",
    "parser_fallback_backend": "pypdf",
    "embedding_model": "BAAI/bge-m3",
    "embedding_cache_dir": "./runtime_data/model_cache",
    "llm_model": "glm-4-flash",
    "milvus_uri": "http://127.0.0.1:19530",
    "milvus_token": "",
    "milvus_timeout_seconds": 5.0,
    "collection_name": "industry_research_knowledge_bge_m3",
    "chunk_size": 800,
    "chunk_overlap": 120,
    "max_chunks_per_document": 60,
    "retrieval_top_k": 6,
    "hybrid_alpha": 0.75,
    "bm25_top_k": 12,
    "bm25_k1": 1.5,
    "bm25_b": 0.75,
    "rerank_top_k": 12,
    "enable_model_rerank": true,
    "reranker_model": "BAAI/bge-reranker-v2-m3",
    "reranker_use_fp16": false,
    "reranker_batch_size": 8,
    "reranker_max_length": 512,
    "reranker_weight": 0.85,
    "reranker_fallback": true
  },
  "graph": {
    "enable_query_rewrite": true,
    "enable_reflection": true,
    "max_reflection_rounds": 1,
    "reflection_retry_score_threshold": 0.6,
    "reflection_rule_score_weight": 0.65,
    "reflection_min_evidence_items": 3,
    "reflection_min_source_count": 2,
    "reflection_min_citation_coverage": 0.5,
    "reflection_min_retrieval_score": 0.45,
    "reflection_enforce_quality_gates": true,
    "reflection_evidence_count_weight": 0.25,
    "reflection_source_count_weight": 0.2,
    "reflection_citation_coverage_weight": 0.3,
    "reflection_retrieval_score_weight": 0.25,
    "default_thread_id": "default-thread",
    "default_user_id": "default-user",
    "max_history_messages": 6,
    "max_memory_items": 4,
    "use_sqlite_checkpointer": true
  },
  "tools": {
    "timeout_seconds": 30.0,
    "max_retries": 1
  },
  "observability": {
    "enabled": true,
    "persist_jsonl": true
  },
  "memory": {
    "redis_url": "redis://127.0.0.1:6379/0",
    "redis_key_prefix": "industry_research_agent:thread",
    "redis_ttl_seconds": 604800,
    "redis_socket_timeout_seconds": 5.0,
    "milvus_uri": "http://127.0.0.1:19530",
    "milvus_token": "",
    "milvus_timeout_seconds": 5.0,
    "collection_name": "user_long_term_memory_bge_m3",
    "min_similarity": 0.45,
    "duplicate_similarity": 0.92,
    "candidate_limit": 12,
    "enable_llm_compression": true,
    "interaction_summary_max_chars": 600,
    "enable_thread_compression": true,
    "thread_summary_max_chars": 1200
  },
  "database": {
    "enabled": false,
    "url": "mysql+pymysql://root:password@127.0.0.1:3306/industry_research_agent?charset=utf8mb4",
    "init_schema": true
  }
