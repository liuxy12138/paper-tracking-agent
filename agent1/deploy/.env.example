# Copy to .env and fill in real values. Do not commit .env.
DOMAIN=research.example.com
BASIC_AUTH_USER=researcher
# Generate: docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-long-password'
# Keep the resulting hash in single quotes to prevent dollar-sign interpolation.
BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_GENERATED_HASH'
ZHIPU_API_KEY=replace_with_your_key
TAVILY_API_KEY=
